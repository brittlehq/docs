---
/**
 * Quiet text-only feature card. Used as the smaller siblings of the
 * bento hero cards in the Features section. Mono kicker + brand title +
 * single body paragraph. A small amber dot in the top-right anchors the
 * card visually without needing iconography.
 *
 * Hover: subtle lift + accent border + soft radial wash from the top
 * right corner.
 */
interface Props {
  kicker: string;
  title: string;
  body: string;
  class?: string;
}

const { kicker, title, body, class: className } = Astro.props;
---

<article
  class:list={[
    'group relative overflow-hidden rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-7 transition-all duration-200 hover:-translate-y-0.5 hover:border-[color:var(--color-accent)]/40 hover:bg-[color:var(--color-surface-2)]',
    className,
  ]}
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style="background: radial-gradient(circle at 100% 0%, color-mix(in oklch, var(--color-accent) 12%, transparent), transparent 60%);"
    aria-hidden="true"
  ></div>
  <span
    class="absolute right-7 top-7 h-1.5 w-1.5 rounded-full bg-[color:var(--color-accent)] transition-shadow group-hover:shadow-[0_0_16px_color-mix(in_oklch,var(--color-accent)_70%,transparent)]"
    aria-hidden="true"
  ></span>
  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-accent-soft)]">
    {kicker}
  </p>
  <h3
    class="mt-3 text-balance text-xl leading-snug tracking-tight text-[color:var(--color-fg)]"
    style="font-family: var(--font-brand); font-weight: 600;"
  >
    {title}
  </h3>
  <p class="mt-3 text-[color:var(--color-fg-muted)] leading-relaxed">
    {body}
  </p>
</article>
