---
import TestGrid from './TestGrid.astro';

/**
 * Above-the-fold pitch. Centered headline + subhead + dual CTA. Geometric
 * backdrop:
 *   - dot grid masked to a center oval (carries the "many tests / many envs"
 *     density without distracting from the copy)
 *   - amber crack ruled across the upper third, mirroring the dashboard's
 *     login backdrop so the two surfaces match
 *   - a small static "test grid" decoration on the right: 7×5 squares with
 *     a few amber dots representing failing cells, suggesting the product
 *     without showing an actual screenshot
 */
---

<section class="relative isolate overflow-hidden">
  {/* Backdrop layers ------------------------------------------------------ */}
  <div class="dot-grid absolute inset-0 -z-10" aria-hidden="true"></div>
  {/* Fixed offset from the top instead of a percentage. Percentages
      scale with section height, which doubles on mobile when the hero
      content stacks, and the crack ended up cutting through the kicker
      text. A pixel offset keeps it in the breathing space above the
      copy regardless of viewport. */}
  <div
    class="brand-crack absolute inset-x-0 top-12 -z-10"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 -z-10"
    style="background: radial-gradient(ellipse 70% 50% at 50% 0%, color-mix(in oklch, var(--color-accent) 8%, transparent), transparent 70%);"
    aria-hidden="true"
  ></div>

  {/* Content -------------------------------------------------------------- */}
  <div class="container-fixed relative grid items-center gap-12 py-24 md:grid-cols-12 md:py-32">
    <div class="md:col-span-7">
      <p
        class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-accent-soft)]"
      >
        <span class="block h-1.5 w-1.5 rounded-full bg-[color:var(--color-accent)] shadow-[0_0_8px_color-mix(in_oklch,var(--color-accent)_80%,transparent)]"></span>
        Playwright grid · flake analytics
      </p>
      <h1
        class="mt-4 text-balance text-5xl leading-[1.05] tracking-tight text-[color:var(--color-fg)] sm:text-6xl md:text-7xl"
        style="font-family: var(--font-brand); font-weight: 700;"
      >
        Tame the <span class="glow-amber text-[color:var(--color-accent)]">flaky</span> test.
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-[color:var(--color-fg-muted)]">
        Self-hosted Playwright grid with flake analytics built in.
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a
          href="https://brittle.dev"
          class="inline-flex items-center gap-2 rounded-md bg-[color:var(--color-accent)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-bg)] transition-opacity hover:opacity-90"
        >
          Try the live demo
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden>
            <path d="M5 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a
          href="https://github.com/brittlehq/brittle"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-2 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-surface)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-fg)] transition-colors hover:border-[color:var(--color-fg-subtle)]"
        >
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden>
            <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.16-.89-1.16-.72-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.96 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.62 7.62 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.52.56.83 1.28.83 2.15 0 3.08-1.87 3.76-3.65 3.96.29.25.54.74.54 1.49v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0z" />
          </svg>
          View on GitHub
        </a>
      </div>

      <p class="mt-6 text-xs text-[color:var(--color-fg-subtle)]">
        Apache 2.0 · One Postgres, one container · Runs in your VPC
      </p>
    </div>

    <div class="hidden md:col-span-5 md:block">
      <TestGrid />
    </div>
  </div>

  {/* Soft fade to next section so the dot grid doesn't hard-stop at the
      section boundary. */}
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-32"
    style="background: linear-gradient(to bottom, transparent, var(--color-bg));"
    aria-hidden="true"
  ></div>
</section>
