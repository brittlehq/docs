---
/**
 * Quiet horizontal strip between the hero and the "how it works" section.
 * Three short fact pills bridge the white space and reinforce the product
 * positioning without leaning on fake metrics. The brand-crack rule lines
 * through the strip is the connective tissue back to the hero accent.
 *
 * Keep this minimal. It's a transition surface, not a section. If we ever
 * have real numbers (test runs ingested, orgs running brittle), they live
 * here.
 */
const items = [
  { kicker: 'rollup key', value: '(testId, branch, env, target)' },
  { kicker: 'flake rule', value: 'same commit, both outcomes' },
  { kicker: 'deploy', value: 'one container, one Postgres' },
];
---

<section class="relative -mt-12 py-10">
  <div class="container-fixed">
    <div
      class="relative grid items-center gap-y-6 rounded-xl border border-[color:var(--color-border)]/60 bg-[color:var(--color-surface)]/40 px-8 py-6 backdrop-blur-sm md:grid-cols-3 md:gap-x-10 md:py-7"
    >
      <div class="brand-crack-soft pointer-events-none absolute inset-x-10 top-0 -translate-y-1/2" aria-hidden="true"></div>

      {items.map((it, i) => (
        <div
          class:list={[
            'flex flex-col gap-1',
            i > 0 && 'md:border-l md:border-[color:var(--color-border)] md:pl-10',
          ]}
        >
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-fg-subtle)]">
            {it.kicker}
          </span>
          <span class="font-mono text-sm text-[color:var(--color-fg)]">
            {it.value}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
