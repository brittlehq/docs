---
/**
 * Single-card "we're open source" affirmation. Sits between the features /
 * snippet and the footer so the last bit of copy before leaving the page
 * reinforces "you can run this yourself". The main differentiator vs.
 * SaaS-only test observability platforms.
 */
---

<section class="relative py-24" data-section="oss_banner">
  <div class="container-fixed">
    <div
      class="relative overflow-hidden rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-10 md:p-14"
    >
      {/* Faint dot grid behind the copy */}
      <div class="dot-grid-tight absolute inset-0 opacity-25" aria-hidden="true"></div>
      <div
        class="brand-crack absolute inset-x-10 top-6"
        aria-hidden="true"
      ></div>

      <div class="relative grid items-center gap-10 md:grid-cols-2">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-[color:var(--color-accent-soft)]">
            Open source · Apache 2.0
          </p>
          <h2
            class="mt-3 text-balance text-3xl tracking-tight text-[color:var(--color-fg)] sm:text-4xl"
            style="font-family: var(--font-brand); font-weight: 700;"
          >
            Run it on brittle.dev, or run it yourself.
          </h2>
          <p class="mt-4 max-w-md text-[color:var(--color-fg-muted)] leading-relaxed">
            Hub, dashboard, reporter, node executors. All Apache 2.0 licensed.
          </p>
        </div>

        <div class="flex flex-col items-start gap-3 md:items-end">
          <a
            href="https://github.com/brittlehq/brittle"
            target="_blank"
            rel="noreferrer"
            data-track="github_clicked"
            data-track-props='{"source":"oss_banner"}'
            class="inline-flex items-center gap-2 rounded-md border border-[color:var(--color-border)] bg-[color:var(--color-bg-elev)] px-5 py-2.5 text-sm font-medium text-[color:var(--color-fg)] transition-colors hover:border-[color:var(--color-fg-subtle)]"
          >
            <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden>
              <path d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.34c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.16-.89-1.16-.72-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.96 0-.87.31-1.59.83-2.15-.08-.2-.36-1.02.08-2.13 0 0 .67-.21 2.2.82a7.62 7.62 0 0 1 4 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.93.08 2.13.52.56.83 1.28.83 2.15 0 3.08-1.87 3.76-3.65 3.96.29.25.54.74.54 1.49v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0z" />
            </svg>
            brittlehq/brittle on GitHub
          </a>
          <a
            href="/docs"
            data-track="docs_clicked"
            data-track-props='{"page":"self_host","source":"oss_banner"}'
            class="inline-flex items-center gap-1.5 text-sm text-[color:var(--color-fg-muted)] transition-colors hover:text-[color:var(--color-fg)]"
          >
            Self-host guide
            <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" aria-hidden>
              <path d="M5 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
