---
import Logo from './Logo.astro';

/**
 * Page footer. Three column groups + a single closing tagline. Style stays
 * quiet. The brand and the CTA already did their work above.
 */
type FooterColumn = { heading: string; links: Array<{ href: string; label: string; external?: boolean }> };
const columns: FooterColumn[] = [
  {
    heading: 'Product',
    links: [
      { href: 'https://app.brittle.dev', label: 'Live demo', external: true },
      { href: '/#features', label: 'Features' },
      { href: '/docs', label: 'Docs' },
    ],
  },
  {
    heading: 'Open source',
    links: [
      { href: 'https://github.com/brittlehq/brittle', label: 'GitHub', external: true },
      { href: 'https://www.npmjs.com/org/brittlehq', label: 'npm', external: true },
    ],
  },
  {
    heading: 'Company',
    links: [
      { href: '/contact', label: 'Contact' },
      { href: '/privacy', label: 'Privacy' },
      { href: '/terms', label: 'Terms' },
    ],
  },
];
---

<footer class="border-t border-[color:var(--color-border-soft)] py-16">
  <div class="container-fixed">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-12 md:gap-16">
      <div class="md:col-span-5">
        <a href="/" class="block h-7 text-[color:var(--color-fg)]" aria-label="Brittle home">
          <Logo variant="lockup" class="h-full" />
        </a>
        <p class="mt-4 max-w-sm text-sm text-[color:var(--color-fg-muted)] leading-relaxed">
          Self-hosted test observability for Playwright, WebdriverIO,
          Vitest, and Jest. Apache 2.0 licensed.
        </p>
      </div>

      {columns.map((col) => (
        <div class="md:col-span-2">
          <h4 class="font-mono text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-fg-subtle)]">
            {col.heading}
          </h4>
          <ul class="mt-4 flex flex-col gap-2.5 text-sm">
            {col.links.map((l) => (
              <li>
                <a
                  href={l.href}
                  target={l.external ? '_blank' : undefined}
                  rel={l.external ? 'noreferrer' : undefined}
                  data-track="footer_link_clicked"
                  data-track-props={JSON.stringify({ section: col.heading.toLowerCase().replace(/\s+/g, '_'), label: l.label })}
                  class="text-[color:var(--color-fg-muted)] transition-colors hover:text-[color:var(--color-fg)]"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div
      class="brand-crack mt-14 mb-8"
      aria-hidden="true"
    ></div>

    <div class="flex flex-col-reverse items-start justify-between gap-4 text-xs text-[color:var(--color-fg-subtle)] sm:flex-row sm:items-center">
      <p>&copy; {new Date().getFullYear()} Brittle. Apache 2.0 licensed.</p>
      <p class="font-mono">brittle.dev · @brittlehq</p>
    </div>
  </div>
</footer>
