{
  "name": "brittle",
  "version": "0.0.0",
  "private": true,
  "description": "Public-facing repo for brittle.dev — marketing site, docs, and shared brand assets.",
  "scripts": {
    "dev": "pnpm --filter @brittle/site dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @brittle/site preview",
    "format": "prettier --write \"apps/**/src/**/*.{astro,ts,tsx,md,mdx,css}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9"
  },
  "packageManager": "pnpm@9.12.0"
}
